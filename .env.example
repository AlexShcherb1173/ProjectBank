# Ключ API для сервиса валют
CURRENCY_API_KEY=your_currency_api_key_here

# Базовый URL API валют (можно менять, если меняется провайдер)
CURRENCY_API_BASE_URL=https://api.exchangerate.host/latest

# Базовый URL API сервиса акций (можно менять, если меняется провайдер)
STOCK_API_BASE_URL=https://query1.finance.yahoo.com/v8/finance/chart

# Ключ API для сервиса акций
STOCK_API_KEY=your_stock_api_key_here

# Путь к файлу с пользовательскими настройками (валюты и акции)
USER_SETTINGS_FILE=user_settings.json

# Путь к Excel-файлу с транзакциями
TRANSACTIONS_FILE=transactions.xlsx